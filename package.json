{
  "name": "peladapro",
  "private": true,
  "version": "1.2.4",
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "build": "vite build && node scripts/generate-ota.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "deploy:ota": "node scripts/deploy-ota.mjs",
    "build:mobile": "npm run build && node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:sync": "node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:apk": "npm run build:mobile && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1",
    "android:release": "npm run build:mobile && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/android-build.ps1 -Release",
    "start": "node ./node_modules/tsx/dist/cli.mjs server.ts",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "test": "node ./node_modules/tsx/dist/cli.mjs --test src/utils/peladaLogic.test.ts",
    "clean": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.rmSync('server.js',{force:true});\"",
    "lint": "node ./node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.1",
    "@capacitor/core": "^8.0.1",
    "@capgo/capacitor-updater": "^8.54.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "adm-zip": "^0.6.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.4.3",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.2",
    "@types/adm-zip": "^0.5.8",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
