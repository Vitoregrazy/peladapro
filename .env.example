# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# POSTGRES_URL / DATABASE_URL: String de conexão do Vercel Postgres / Neon
POSTGRES_URL="MY_POSTGRES_URL"
DATABASE_URL="MY_POSTGRES_URL"

# GITHUB_TOKEN / GITHUB_REPO: Alternativa gratuita usando repositório do GitHub como banco de dados JSON
GITHUB_TOKEN=""
GITHUB_REPO="vitoregrazy/peladapro-db"
GITHUB_DB_PATH="db/rooms-data.json"

# VITE_API_BASE_URL: URL base da API na Vercel usada pelo APK Android
VITE_API_BASE_URL="https://peladapro-vitor-hugo-s-projects-d627ca8c.vercel.app"
